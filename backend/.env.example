PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Set this when local uploads need absolute URLs from a deployed frontend.
PUBLIC_API_URL=
MONGODB_URI=mongodb://localhost:27017/iron-steel-commerce
JWT_SECRET=replace-with-a-long-random-secret

# Email verification; for Gmail, use a Google App Password rather than your account password.
EMAIL_SERVICE=Gmail
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Razorpay test credentials are available from your Razorpay dashboard.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Optional: product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
